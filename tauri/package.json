{
  "name": "tabbar-tauri",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Lean native-webview edition of Tabbar",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^6.4.1"
  }
}
