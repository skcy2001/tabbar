{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Only the bundled shell may manage the browser. Website webviews have no native permissions.",
  "local": true,
  "webviews": ["ribbon", "pane", "player", "downloads", "edge"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "allow-get-state", "allow-act", "allow-query"]
}
